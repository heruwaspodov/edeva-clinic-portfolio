{
    "hosting": {
        "public": "dist",
        "cleanUrls": true,
        "redirects": [
            { "source": "/portfolio", "destination": "/our-clinic", "type": 301 },
            { "source": "/portfolio.html", "destination": "/our-clinic", "type": 301 }
        ],
        "ignore": [
            "firebase.json",
            ".firebaserc",
            ".git/**",
            ".github/**",
            ".firebase/**",
            "**/.DS_Store",
            "node_modules/**",
            "README.md"
        ]
    }
}
